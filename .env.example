# =======================================================
# Las Aventuras de Curileta — Variables de Entorno
# =======================================================

# -------------------------------------------------------
# URL Base del Proyecto
# -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.curileta.com
NEXT_PUBLIC_GOOGLE_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# -------------------------------------------------------
# Envío de Correos y Contacto Profesional
# -------------------------------------------------------
# Clave secreta de Resend. Guardar solo en el entorno del servidor.
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend y buzón de reserva para avisos.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Opcional: versión del aviso de privacidad aceptado. Si se omite se usa el valor del código.
PRIVACY_NOTICE_VERSION=

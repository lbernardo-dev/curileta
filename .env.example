# =======================================================
# Las Aventuras de Curileta — Variables de Entorno
# =======================================================

# -------------------------------------------------------
# URL Base del Proyecto
# -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://curileta.com

# -------------------------------------------------------
# Sanity Studio & Headless CMS (sanity.io)
# -------------------------------------------------------
# ID de tu proyecto en Sanity (puedes crearlo con 'npx sanity init' o en sanity.io)
NEXT_PUBLIC_SANITY_PROJECT_ID=curileta-demo
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=curileta-demo
SANITY_STUDIO_DATASET=production

# Token de lectura opcional para contenido en borrador / Live Preview
# SANITY_API_READ_TOKEN=sk...

# -------------------------------------------------------
# Seguridad e Invalidación de Caché On-Demand (Webhooks)
# -------------------------------------------------------
# Clave secreta compartida entre el webhook de Sanity y Next.js (/api/revalidate?secret=...)
SANITY_REVALIDATE_SECRET=tu-clave-secreta-de-revalidacion

# -------------------------------------------------------
# Envío de Correos y Contacto Profesional
# -------------------------------------------------------
# Clave del proveedor de correos transaccionales (ej: Resend, Brevo, SendGrid)
# RESEND_API_KEY=re_123456789

# Correos destino según departamento (opcionales, por defecto usan los oficiales)
CONTACT_EMAIL_EDITORIAL=editorial@curileta.com
CONTACT_EMAIL_PRESS=prensa@curileta.com
CONTACT_EMAIL_LICENSING=licencias@curileta.com
CONTACT_EMAIL_GENERAL=hola@curileta.com

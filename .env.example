# =======================================================
# Las Aventuras de Curileta — Variables de Entorno
# =======================================================

# -------------------------------------------------------
# URL Base del Proyecto
# -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.curileta.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-19EJT6NRCF

# -------------------------------------------------------
# Sanity Studio & Headless CMS (sanity.io)
# -------------------------------------------------------
# ID de tu proyecto en Sanity (puedes crearlo con 'npx sanity init' o en sanity.io)
NEXT_PUBLIC_SANITY_PROJECT_ID=curileta-demo
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=curileta-demo
SANITY_STUDIO_DATASET=production

# Token de lectura opcional para contenido en borrador / Live Preview
# SANITY_API_READ_TOKEN=sk...

# -------------------------------------------------------
# Seguridad e Invalidación de Caché On-Demand (Webhooks)
# -------------------------------------------------------
# Clave secreta compartida para validar la firma del webhook de Sanity en /api/revalidate.
SANITY_REVALIDATE_SECRET=

# -------------------------------------------------------
# Envío de Correos y Contacto Profesional
# -------------------------------------------------------
# Clave secreta de Resend. Guardar solo en el entorno del servidor.
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend y buzón de reserva para avisos.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Opcional: versión del aviso de privacidad aceptado. Si se omite se usa el valor del código.
PRIVACY_NOTICE_VERSION=

# Base URL used for canonical metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://curileta-pink.vercel.app

# Supabase project settings. Keep the secret key on the server only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Sanity Content Lake settings for the editorial CMS.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
NEXT_PUBLIC_SANITY_STUDIO_URL=
SANITY_READ_TOKEN=
SANITY_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Contact form delivery through the Resend Email API.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
PRIVACY_NOTICE_VERSION=

# Authorization for the scheduled lead retention endpoint. Configure it in the scheduler too.
CRON_SECRET=

# Cloudflare Turnstile anti spam verification for production contact forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

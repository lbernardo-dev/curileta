{
  "name": "curileta-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:studio": "npm run dev --workspace=apps/studio",
    "dev:all": "npm run dev --workspaces --if-present",
    "sanity:import:dry-run": "node --env-file=apps/web/.env.local --experimental-strip-types tooling/scripts/import-local-content-to-sanity.mjs --dry-run",
    "sanity:import": "node --env-file=apps/web/.env.local --experimental-strip-types tooling/scripts/import-local-content-to-sanity.mjs",
    "sanity:migrate-public-ids:dry-run": "node --env-file=apps/web/.env.local tooling/scripts/migrate-sanity-public-document-ids.mjs --dry-run",
    "sanity:migrate-public-ids": "node --env-file=apps/web/.env.local tooling/scripts/migrate-sanity-public-document-ids.mjs",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test 'tooling/tests/**/*.test.mjs'",
    "clean": "node tooling/scripts/clean-generated-artifacts.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "supabase": "2.121.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@vercel/frameworks": {
      "smol-toml": "^1.9.1",
      "js-yaml": "3.15.2",
      "argparse": "2.0.1"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    }
  }
}
